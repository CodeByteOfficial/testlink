# ==============================================================================
# 🚀 TESTLINK AUTOMATION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# NOTE: This file is a TEMPLATE committed to Git repository.
# DO NOT put sensitive production secrets here.
# Copy this file to '.env' (which is git-ignored and NEVER pushed to git):
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TestLink Server & Gateway Authentication
# ------------------------------------------------------------------------------
# Base URL of your TestLink server instance
TESTLINK_BASE_URL=https://testing.creditq.co.in

# HTTP Basic Authentication (IIS / Nginx / Server Gate)
HTTP_AUTH_USERNAME=cqtesting
HTTP_AUTH_PASSWORD=your_gateway_password_here

# ------------------------------------------------------------------------------
# 2. TestLink Portal User Login Credentials
# ------------------------------------------------------------------------------
# TestLink web login credentials
TESTLINK_USER=your_testlink_username
TESTLINK_PASS=your_testlink_password

# ------------------------------------------------------------------------------
# 3. Test Project & Test Plan Configuration
# ------------------------------------------------------------------------------
# Test Project dropdown option value ('1' -> "CQ:CreditQ")
TARGET_PROJECT_VALUE=1
# Test Project name label in left tree (e.g. CreditQ)
TARGET_PROJECT_NAME=CreditQ
# Active Test Plan name (e.g. "6.7.1 Release", "New Admin Portal", "6.6 Release")
TARGET_PLAN_LABEL=6.7.1 Release

# ------------------------------------------------------------------------------
# 4. Tester Configuration
# ------------------------------------------------------------------------------
# Tester dropdown value ('9' for harsh, or user ID)
TESTER_ID=9

# ------------------------------------------------------------------------------
# 5. Build Configuration for Active Test Plan
# ------------------------------------------------------------------------------
# Build ID and Build Name (Leave blank to auto-detect latest build in Test Plan)
TARGET_BUILD_ID=96
TARGET_BUILD_NAME=Round _1

# ------------------------------------------------------------------------------
# 6. File Paths & Storage Directories
# ------------------------------------------------------------------------------
# Directory where converted XML files are saved (Leave blank to auto-detect system Downloads folder)
XML_DIR=

# Path to the test suites manifest file
TEST_JSON_PATH=playwright/tests/test.json

# ------------------------------------------------------------------------------
# 7. Playwright Automation Runner Settings
# ------------------------------------------------------------------------------
# Step Delay (in milliseconds between automation steps)
DELAY_MS=3000

# Action timeout (in milliseconds for page interactions)
STEP_TIMEOUT_MS=30000

# Browser execution mode (true = background, false = visible browser window)
HEADLESS=false

# Action slow-motion delay (in milliseconds)
SLOW_MO=300
